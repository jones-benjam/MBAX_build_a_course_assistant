# Copy to .env and fill in the values your instructor gave you.
# NEVER commit .env. Dummy values below.

# Set to 1 to run fully offline with deterministic stand-in services (tests, demos).
MOCK_SERVICES=1

# Vision-capable chat LLM (OpenAI-compatible chat/completions assumed; adjust if different)
LLM_BASE_URL=https://dobolyi.com:9001/v1
LLM_API_KEY=sk-dummy-llm-key
LLM_MODEL=class-vision-llm

# Text embeddings
TEXT_EMBED_BASE_URL=https://dobolyi.com:9002/v1
TEXT_EMBED_API_KEY=sk-dummy-embed-key
TEXT_EMBED_MODEL=class-text-embed

# Visual (image) embeddings
VISUAL_EMBED_BASE_URL=https://dobolyi.com:9003/v1
VISUAL_EMBED_API_KEY=sk-dummy-visual-key
VISUAL_EMBED_MODEL=class-visual-embed

# Multimodal reranker
RERANK_BASE_URL=https://dobolyi.com:9004/v1
RERANK_API_KEY=sk-dummy-rerank-key
RERANK_MODEL=class-reranker

# Document parsing service (optional; local PyMuPDF parsing is the fallback)
PARSER_BASE_URL=https://dobolyi.com:9005
PARSER_API_KEY=sk-dummy-parser-key

# App settings
DATA_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8
USE_RERANKER=1
