# Copy to .env and fill in the values your instructor gave you.
# NEVER commit .env. Dummy values below.

# Set to 1 to run fully offline with deterministic stand-in services (tests, demos).
# Set to 0 to use the real endpoints configured below.
MOCK_SERVICES=1

# The class endpoints are plain-HTTP vLLM servers (OpenAI-compatible routes).
# Give the base URL as host:port; the client adds /v1 itself if you leave it off.
# Port 9000 is reserved for another service; the vision LLM is on 9001.

# Vision-capable chat LLM (POST /v1/chat/completions)
LLM_BASE_URL=http://model-host.example.edu:9001
LLM_API_KEY=sk-dummy-llm-key
LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit

# Text embeddings (POST /v1/embeddings; "query: " / "passage: " prefixes are added by the client)
TEXT_EMBED_BASE_URL=http://model-host.example.edu:9002
TEXT_EMBED_API_KEY=sk-dummy-embed-key
TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16

# Visual (image + text) embeddings (POST /v1/embeddings, chat-style messages)
VISUAL_EMBED_BASE_URL=http://model-host.example.edu:9003
VISUAL_EMBED_API_KEY=sk-dummy-visual-key
VISUAL_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B

# Multimodal reranker (POST /v1/rerank)
RERANK_BASE_URL=http://model-host.example.edu:9004
RERANK_API_KEY=sk-dummy-rerank-key
RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B

# Document parsing service (optional; local PyMuPDF + LibreOffice parsing is what the app uses)
PARSER_BASE_URL=http://model-host.example.edu:9005
PARSER_API_KEY=sk-dummy-parser-key

# App settings
DATA_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8
USE_RERANKER=1
